{
  "dependencies": [
    "@rescript/react",
    "@tilia/react",
    "rescript-react-intl",
    "rescript-react-update",
    "rescript-webapi",
    "tilia"
  ],
  "compiler-flags": ["-open Webapi.Dom"],
  "gentypeconfig": {
    "language": "typescript",
    "generatedFileExtension": ".gen.tsx",
    "module": "esmodule",
    "moduleResolution": "node",
    "debug": {
      "all": false,
      "basic": false
    }
  },
  "jsx": {
    "version": 4
  },
  "name": "check.beer",
  "package-specs": [
    {
      "module": "esmodule",
      "in-source": true
    }
  ],
  "sources": [
    {
      "dir": "src",
      "subdirs": true
    }
  ],
  "suffix": ".bs.js"
}
